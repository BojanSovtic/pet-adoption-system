# Production settings for docker-compose.prod.yml. On the server, copy this
# file to `.env.production` next to the compose file, fill it in, and run
# `chmod 600 .env.production`. Never commit the filled-in file (.gitignore and
# .dockerignore exclude it). Keep a copy of the secrets in a password manager.
# Everything else (NODE_ENV, TRUST_PROXY, CORS_ORIGIN, UPLOADS_*) is set in the
# compose file from SITE_DOMAIN.
#
# Values are read by Docker Compose: don't quote them, and avoid `$` in them
# (Compose would treat it as a variable). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   (or: openssl rand -base64 32 | tr -d '/+=')

# The public host name, without https:// (a DuckDNS name or your own domain).
# Its DNS record must point at this server before the first start.
SITE_DOMAIN=your-name.duckdns.org

# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=you@example.com

# Secret. MongoDB Atlas → your cluster → Connect → Drivers. A database user
# with readWrite on the pet-adoption database only; a letters-and-digits
# password. The database name (/pet-adoption) must be in the path.
MONGODB_URI=mongodb+srv://pet-adoption-api:CHANGE_ME@your-cluster.xxxxx.mongodb.net/pet-adoption?retryWrites=true&w=majority

# Secret, 32+ random characters (left empty here: Compose refuses to start
# until it is set). Changing it signs everyone out.
SESSION_SECRET=

# Secret, 32+ random characters. Signs the admin audit log; never change it
# once the site is live (older entries could no longer be verified).
AUDIT_HMAC_KEY=

# Optional: debug, info (default), warn, error or silent.
LOG_LEVEL=info
