# Settings for the managed deployment: the web app on Cloudflare Pages (with
# the /api pass-through Function), the API on Render (apps/api/Dockerfile),
# MongoDB Atlas Free and Cloudinary for photos. The self-hosted deployment
# uses .env.production.example instead.
#
# Nothing reads this file. Enter each value in the provider's dashboard and
# keep the secrets in a password manager; never commit real values.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ============================================================================
# Render: web service → Environment
# ============================================================================
# PORT is set by Render. NODE_ENV=production is set by the Dockerfile.

# Listen on all interfaces inside the container (Render's proxy connects to it).
HOST=0.0.0.0

# Secret. Atlas → cluster → Connect → Drivers. User pet-adoption-api,
# readWrite on pet-adoption only, letters-and-digits password; the database
# name must be in the path.
MONGODB_URI=mongodb+srv://pet-adoption-api:CHANGE_ME@your-cluster.xxxxx.mongodb.net/pet-adoption?retryWrites=true&w=majority

# The Pages site's origin, exactly (https, no trailing slash). The API's CSRF
# check compares the browser's Origin header with it.
CORS_ORIGIN=https://your-project.pages.dev

# Secret, 32+ random characters. Signs session cookies.
SESSION_SECRET=

# Secret, 32+ random characters. Signs the admin audit log. Changing it later
# makes older entries unverifiable.
AUDIT_HMAC_KEY=

# Secret, 32+ random characters (visible ASCII, no spaces). The same value as
# PROXY_SECRET in Cloudflare Pages. Requests without it get 403, except the
# liveness probe /api/health (use it as Render's health check path).
PROXY_SECRET=

# How many proxies in front of the API to trust for X-Forwarded-Proto (HTTPS
# detection, needed for the Secure session cookie). The client IP doesn't
# depend on it here: the API takes it from the Pages Function, authenticated
# by PROXY_SECRET. Expected value 1 (Render's proxy terminates TLS); confirm on
# the first deployment, through the Pages site:
#   1. Sign in: the sid cookie must be set with Secure (browser dev tools →
#      Application → Cookies), and /api/auth/me must then return 200. With a
#      wrong value the API sees plain HTTP, sends no cookie and sign-in fails.
#   2. Per-IP limits: 21 invalid registrations from one network → 429; another
#      network (e.g. phone data) is still allowed.
#   3. Direct to Render (https://<service>.onrender.com/api/ready) → 403
#      PROXY_REQUIRED; /api/health → 200.
TRUST_PROXY=1

# Photos in Cloudinary (the disk on Render is wiped on every restart).
STORAGE_DRIVER=cloudinary
# Cloudinary console → Settings → API Keys. The secret stays on the server:
# uploads are signed by the API, and browsers only load the public photo URLs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# Secret.
CLOUDINARY_API_SECRET=

# Email through Brevo's HTTPS API (Render's free instances block SMTP). The
# only driver allowed in production, and required: the API doesn't start
# without it.
EMAIL_DRIVER=brevo
# Secret. Brevo → SMTP & API → API keys.
BREVO_API_KEY=
# A sender address verified in Brevo (plain address, no display name).
EMAIL_FROM=
# Optional: the sender's display name (default "Pet Adoption").
# EMAIL_FROM_NAME=Pet Adoption

# Optional: debug, info (default), warn, error, silent.
# LOG_LEVEL=info

# ============================================================================
# Cloudflare Pages: project settings (not environment files)
# ============================================================================
# Build (root directory: the repository root, so functions/ is found there):
#   Build command:          pnpm nx build @pet-adoption/web
#   Build output directory: dist/apps/web
#   Build variable:         VITE_API_URL=/api   (public: it ends up in the
#                           browser bundle; never put a secret in a VITE_ variable)
# Functions → Variables and Secrets (production):
#   API_ORIGIN=https://your-service.onrender.com   (variable, no trailing path)
#   PROXY_SECRET=...                                (type "Secret", same value as above)
