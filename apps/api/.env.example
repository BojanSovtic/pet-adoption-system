PORT=3333
HOST=localhost
# MongoDB must be a replica set (transactions). This matches docker-compose.yml;
# `directConnection=true` connects straight to the single node.
MONGODB_URI=mongodb://localhost:27018/pet-adoption?directConnection=true
CORS_ORIGIN=http://localhost:4200
# At least 32 random characters, e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Set to "production" in production (enables Secure cookies; then TRUST_PROXY
# is required).
NODE_ENV=development
# Which proxies in front of the API to trust for the client IP and HTTPS
# (X-Forwarded-For / X-Forwarded-Proto). It must match the real network; see
# docs/deployment.md. "false" (the default outside production): no proxy, as in
# local development. Otherwise a hop count (e.g. 1) or a comma-separated list
# of the proxies' addresses (IP, CIDR, loopback, linklocal, uniquelocal).
# "true" and catch-all ranges are refused.
# TRUST_PROXY=false
# Optional. Minimum level of the JSON log lines on stdout: debug, info (the
# default), warn, error or silent. "debug" adds successful health checks and
# photo downloads. Any other value stops the API at startup.
# LOG_LEVEL=info
# Optional. Pet photos are stored on local disk (relative to the repo root)
# and served from UPLOADS_BASE_URL. Set the URL when the API is behind a proxy
# or on another host.
# UPLOADS_DIR=apps/api/uploads
# UPLOADS_BASE_URL=http://localhost:3333/uploads
# Optional but recommended outside development: at least 32 random characters,
# kept outside the database. Signs the admin audit log (hash chain), so someone
# with only database access can't rewrite it undetected; check with
# "pnpm audit:verify". Changing it later makes older entries unverifiable.
# AUDIT_HMAC_KEY=
