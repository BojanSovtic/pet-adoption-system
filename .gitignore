# Dependencies
node_modules/

# Build output
dist/
tmp/
out-tsc/

# Environment files
.env
.env.*
!.env.example
!.env.production.example
!.env.render.example
# Cloudflare Wrangler's local secrets file (local Pages Functions runs)
.dev.vars

# User-uploaded files (local file storage)
apps/api/uploads/

# Database dumps and photo archives (production backups belong in
# /var/backups/pet-adoption on the server, never in the repository)
backups/
*.archive.gz
uploads-*.tar.gz

# Test / coverage output
coverage/
test-output/
playwright-report/
test-results/
blob-report/

# TypeScript incremental build info
*.tsbuildinfo

# Nx
.nx/cache/
.nx/workspace-data/
.nx/polygraph/
.nx/self-healing/
.nx/migrate-runs/

# Vite / Vitest
*.timestamp*

# IDEs
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db

# Office lock files (LibreOffice, Excel) while a document is open
.~lock.*#
~$*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Personal learning notes
docs/learning/

# Misc
.sass-cache/
*.sublime-workspace
vitest.config.*.timestamp*
vite.config.*.timestamp*

# Claude Code local settings
.claude/settings.local.json