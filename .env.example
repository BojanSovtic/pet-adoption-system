# Docker QA settings (copy to `.env` in the repository root). Only the
# isolated QA stack reads this file (pnpm qa:up, docker-compose.qa.yml); local
# development uses apps/api/.env and apps/web/.env.

# Required: at least 32 random characters, different from the development
# SESSION_SECRET in apps/api/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QA_SESSION_SECRET=
