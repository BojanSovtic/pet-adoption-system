# Docker Compose settings (copy to `.env` in the repository root).
# Only used by `docker compose --profile app ...`; running the apps with Nx
# uses apps/api/.env and apps/web/.env instead.

# Required: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: host ports for the browser (defaults shown).
# API_PORT=3333
# WEB_PORT=4200

# Required for the isolated Docker QA stack (pnpm qa:up, docker-compose.qa.yml):
# its own secret, at least 32 random characters, different from SESSION_SECRET.
# Generate it the same way as SESSION_SECRET above.
QA_SESSION_SECRET=

# Optional: signs the admin audit log (see apps/api/.env.example). At least 32
# random characters, different from SESSION_SECRET.
# AUDIT_HMAC_KEY=
