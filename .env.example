# Docker Compose settings (copy to `.env` in the repository root).
# Only used by `docker compose --profile app ...`; running the apps with Nx
# uses apps/api/.env and apps/web/.env instead.

# Required: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Optional: host ports for the browser (defaults shown).
# API_PORT=3333
# WEB_PORT=4200
